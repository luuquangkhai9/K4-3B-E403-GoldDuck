OPENAI_API_KEY=
LLM_MODEL=gpt-5.6
DENSE_ENABLED=true
DENSE_CPU_THREADS=1
DENSE_TIMEOUT_SECONDS=15
DENSE_BLOCK_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=45
TOP_K=5
PDF_DIR=data/pdf
INDEX_DIR=data/index
HOST=127.0.0.1
PORT=8000

# Selective Vision (ingestion only; set model to enable API calls)
VISION_ENABLED=true
VISION_PROVIDER=openai
VISION_MODEL=
VISION_TEXT_THRESHOLD=120
VISION_IMAGE_RATIO_THRESHOLD=0.40
VISION_TIMEOUT=30

# External reranker (missing credentials/model falls back to RRF)
RERANK_ENABLED=true
RERANK_PROVIDER=cohere
RERANK_API_KEY=
RERANK_MODEL=
RERANK_CANDIDATES=20
RERANK_TOP_K=5
RERANK_TIMEOUT_SECONDS=10

NEIGHBOR_EXPANSION_ENABLED=true
NEIGHBOR_DISTANCE=1
EVIDENCE_TOP_K=5
MAX_EVIDENCE_PER_SLIDE=2

NO_ANSWER_ENABLED=true
NO_ANSWER_THRESHOLD=
CITATION_VALIDATION_ENABLED=true
